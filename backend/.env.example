# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/mega_socials

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=24h

# SMMRUG Provider
SMMRUG_API_URL=https://smmrug.com/api/v2
SMMRUG_API_KEY=your_api_key_here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@megasocials.com

# Server
PORT=10000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.netlify.app

# Korapay (payment)
KORAPAY_SECRET_KEY=your_korapay_secret
KORAPAY_PUBLIC_KEY=your_korapay_public
KORAPAY_WEBHOOK_SECRET=your_webhook_secret

# Referral
REFERRAL_PERCENT=10
DEFAULT_MARGIN_PERCENT=20

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
